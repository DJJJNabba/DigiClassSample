# ── DigiClass configuration ──────────────────────────────────────────────────
# Copy to .env and fill in. Never commit your real .env.

# Signs the session cookie. REQUIRED in production — generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Path to the SQLite database file.
DATABASE_PATH=digiclass.db

# Optional: enables AI content generation. Without it the app runs fine,
# but the "Generate" feature returns a friendly "not configured" message.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Set to 0 to disable Flask debug mode (recommended in production).
FLASK_DEBUG=0
